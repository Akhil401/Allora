# Copy to .env.local and fill in. NEVER commit .env.local.
# In production these are set as Vercel Project Environment Variables.

# ── Supabase (M2) ──────────────────────────────────────────────
# Public (safe for the browser — inlined by Next):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (NEVER expose to the client):
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for Drizzle migrations:
DATABASE_URL=

# ── LLM providers — failover chain (M3) ────────────────────────
GEMINI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Order the router tries providers in (comma-separated):
LLM_PROVIDER_ORDER=gemini,nvidia-qwen,nvidia-gemma,groq

# ── V3: Jina embeddings — semantic learner memory ──────────────
# Get a free key at https://jina.ai/embeddings/ (1M free tokens).
# Optional: leave blank to run with structured-only memory (no semantic recall).
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3
JINA_EMBED_DIM=1024
